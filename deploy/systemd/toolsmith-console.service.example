[Unit]
Description=Toolsmith Console
After=network.target

[Service]
Type=simple
User=era
Group=era
WorkingDirectory=/opt/toolsmith-console
Environment=HOME=/home/era
Environment=NODE_ENV=production
Environment=HTTP_HOST=0.0.0.0
Environment=HTTP_PORT=5173
ExecStart=/usr/bin/env bun run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
